
<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Добавление — Инсулин</title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >
</head>

<body>

<main class="page add-page">

  {{#if service}}

    <h1>Редактирование черновика</h1>

    <div class="draft-badge">
      ЧЕРНОВИК
    </div>

    <form
      class="service-form"
      method="POST"
      action="/insulin/publish"
    >

      <input
        type="hidden"
        name="id"
        value="{{service.id}}"
      >

      <label>
        Наименование услуги

        <input
          type="text"
          name="name"
          value="{{service.name}}"
          required
        >
      </label>

      <label>
        Тип услуги

        <select
          name="sensitivityCoefficient"
          required
        >
          <option value="1" {{selectedCoefficient1}}>
            КЧИ = 1
          </option>

          <option value="2" {{selectedCoefficient2}}>
            КЧИ = 2
          </option>

          <option value="3" {{selectedCoefficient3}}>
            КЧИ = 3
          </option>

          <option value="4" {{selectedCoefficient4}}>
            КЧИ = 4
          </option>
        </select>
      </label>

      <label>
        Возраст

        <input
          type="number"
          name="age"
          min="1"
          required
          value="{{service.age}}"
        >
      </label>

      <label>
        Вес, кг

        <input
          type="number"
          name="weight"
          min="1"
          step="0.1"
          required
          value="{{service.weight}}"
        >
      </label>

      <label>
        Краткое описание

        <textarea
          name="description"
          required
          placeholder="Введите короткое описание"
        >{{service.description}}</textarea>
      </label>

      <button type="submit">
        Опубликовать
      </button>

    </form>

  {{else}}

    <h1>Новый расчёт</h1>

    <form
      class="service-form add-form"
      method="POST"
      action="/insulin/add"
    >

      <div class="add-media-fields">

        <div class="add-media-field">

          <label
            class="add-media-box"
            for="imageInput"
          >
            <img
              id="imagePreview"
              class="add-media-preview"
              alt="Предпросмотр фотографии"
            >

            <span
              id="imagePlus"
              class="add-media-plus"
            >
              +
            </span>

            <span class="add-media-text">
              Добавить фото
            </span>
          </label>

          <input
            id="imageInput"
            class="add-media-input"
            type="file"
            accept="image/*"
          >

        </div>

        <div class="add-media-field">

          <label
            class="add-media-box"
            for="videoInput"
          >
            <video
              id="videoPreview"
              class="add-media-preview"
              muted
              playsinline
            ></video>

            <span
              id="videoPlus"
              class="add-media-plus"
            >
              +
            </span>

            <span class="add-media-text">
              Добавить видео
            </span>
          </label>

          <input
            id="videoInput"
            class="add-media-input"
            type="file"
            accept="video/*"
          >

        </div>

      </div>

      <label class="add-name-label">
        Название файла

        <input
          type="text"
          name="name"
          required
          placeholder="Введите название"
        >
      </label>

      <button
        class="add-next-button"
        type="submit"
      >
        Далее
      </button>

    </form>

  {{/if}}

</main>

<nav class="bottom-nav">

  <a href="/insulin/feed">
    Лента
  </a>

  <a
    class="active"
    href="/insulin/add"
  >
    Добавление
  </a>

  <a href="/insulin/tile">
    Плитка
  </a>

</nav>

<script>
  const imageInput = document.getElementById('imageInput');
  const imagePreview = document.getElementById('imagePreview');
  const imagePlus = document.getElementById('imagePlus');

  if (imageInput) {
    imageInput.addEventListener('change', function () {
      const file = imageInput.files[0];

      if (!file) {
        return;
      }

      imagePreview.src = URL.createObjectURL(file);
      imagePreview.style.display = 'block';
      imagePlus.style.display = 'none';
    });
  }

  const videoInput = document.getElementById('videoInput');
  const videoPreview = document.getElementById('videoPreview');
  const videoPlus = document.getElementById('videoPlus');

  if (videoInput) {
    videoInput.addEventListener('change', function () {
      const file = videoInput.files[0];

      if (!file) {
        return;
      }

      videoPreview.src = URL.createObjectURL(file);
      videoPreview.style.display = 'block';
      videoPreview.load();
      videoPlus.style.display = 'none';
    });
  }
</script>

</body>
</html>
