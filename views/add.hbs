<!DOCTYPE html>
<html lang="ru">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Добавление — Инсулин
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <style>
    .media-fields {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 20px;
    }

    .media-field {
      position: relative;
    }

    .media-input {
      display: none;
    }

    .media-box {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      border: 2px dashed #aaa;
      border-radius: 12px;
      overflow: hidden;
      cursor: pointer;
      background: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .media-box:hover {
      border-color: #555;
    }

    .media-preview {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none;
    }

    .media-plus {
      font-size: 42px;
      font-weight: 300;
      color: #777;
    }

    .media-label {
      display: block;
      margin-top: 6px;
      text-align: center;
      font-size: 14px;
    }
  </style>

</head>

<body>

<main class="page">

  {{#if service}}

    <h1>
      Редактирование черновика
    </h1>

    <div class="draft-badge">
      ЧЕРНОВИК
    </div>

    <form
      class="service-form"
      method="POST"
      action="/insulin/publish"
    >

      <input
        type="hidden"
        name="id"
        value="{{service.id}}"
      >

      <label>

        Наименование услуги

        <input
          type="text"
          name="name"
          value="{{service.name}}"
          required
        >

      </label>

      <label>

        Тип услуги

        <select
          name="sensitivityCoefficient"
          required
        >

          <option
            value="1"
            {{selectedCoefficient1}}
          >
            КЧИ = 1
          </option>

          <option
            value="2"
            {{selectedCoefficient2}}
          >
            КЧИ = 2
          </option>

          <option
            value="3"
            {{selectedCoefficient3}}
          >
            КЧИ = 3
          </option>

          <option
            value="4"
            {{selectedCoefficient4}}
          >
            КЧИ = 4
          </option>

        </select>

      </label>

      <label>

        Возраст

        <input
          type="number"
          name="age"
          min="1"
          required
          value="{{service.age}}"
        >

      </label>

      <label>

        Вес, кг

        <input
          type="number"
          name="weight"
          min="1"
          step="0.1"
          required
          value="{{service.weight}}"
        >

      </label>

      <label>

        Краткое описание

        <textarea
          name="description"
          required
          placeholder="Введите короткое описание"
        >{{service.description}}</textarea>

      </label>

      <button
        type="submit"
      >
        Опубликовать
      </button>

    </form>

  {{else}}

    <h1>
      Новый расчёт
    </h1>

    <form
      class="service-form"
      method="POST"
      action="/insulin/add"
    >

      <label>

        Название

        <input
          type="text"
          name="name"
          required
          placeholder="Введите название"
        >

      </label>

      <div class="media-fields">

        <div class="media-field">

          <label
            class="media-box"
            for="imageInput"
          >

            <img
              id="imagePreview"
              class="media-preview"
              alt="Предпросмотр фотографии"
            >

            <span
              id="imagePlus"
              class="media-plus"
            >
              +
            </span>

          </label>

          <input
            id="imageInput"
            class="media-input"
            type="file"
            accept="image/*"
          >

          <span class="media-label">
            Фото
          </span>

        </div>

        <div class="media-field">

          <label
            class="media-box"
            for="videoInput"
          >

            <video
              id="videoPreview"
              class="media-preview"
              muted
              playsinline
            ></video>

            <span
              id="videoPlus"
              class="media-plus"
            >
              +
            </span>

          </label>

          <input
            id="videoInput"
            class="media-input"
            type="file"
            accept="video/*"
          >

          <span class="media-label">
            Видео
          </span>

        </div>

      </div>

      <button
        type="submit"
      >
        Далее
      </button>

    </form>

  {{/if}}

</main>

<nav class="bottom-nav">

  <a href="/insulin/feed">
    Лента
  </a>

  <a
    class="active"
    href="/insulin/add"
  >
    Добавление
  </a>

  <a href="/insulin/tile">
    Плитка
  </a>

</nav>

<script>

  const imageInput =
    document.getElementById('imageInput');

  const imagePreview =
    document.getElementById('imagePreview');

  const imagePlus =
    document.getElementById('imagePlus');

  if (imageInput) {
    imageInput.addEventListener(
      'change',
      function () {

        const file =
          imageInput.files[0];

        if (!file) {
          return;
        }

        imagePreview.src =
          URL.createObjectURL(file);

        imagePreview.style.display =
          'block';

        imagePlus.style.display =
          'none';
      },
    );
  }

  const videoInput =
    document.getElementById('videoInput');

  const videoPreview =
    document.getElementById('videoPreview');

  const videoPlus =
    document.getElementById('videoPlus');

  if (videoInput) {
    videoInput.addEventListener(
      'change',
      function () {

        const file =
          videoInput.files[0];

        if (!file) {
          return;
        }

        videoPreview.src =
          URL.createObjectURL(file);

        videoPreview.style.display =
          'block';

        videoPlus.style.display =
          'none';
      },
    );
  }

</script>

</body>

</html>