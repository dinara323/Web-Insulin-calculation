<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Вход</title><link rel="stylesheet" href="/css/sensitivity_coefficient_style.css"><style>main{max-width:520px;margin:50px auto;padding:24px}label{display:block;margin:18px 0}input{display:block;width:100%;box-sizing:border-box;padding:12px}button{padding:12px;margin:8px 8px 8px 0;cursor:pointer}#message{white-space:pre-wrap}</style></head><body><main><h1>Вход и регистрация</h1><form id="auth"><label>Имя пользователя<input name="name" required minlength="3" maxlength="100" autocomplete="username"></label><label>Пароль<input type="password" name="password" required minlength="8" maxlength="72" autocomplete="current-password"></label><button type="submit">Войти</button><button type="button" id="register">Зарегистрироваться</button><button type="button" id="logout">Выйти</button></form><p id="message" role="status"></p><p><a href="/insulin/tile">Плитка</a> · <a href="/insulin/feed">Лента</a> · <a href="/api">Swagger</a></p></main><script>
const form=document.querySelector('#auth'),message=document.querySelector('#message');
async function send(action){try{const body=Object.fromEntries(new FormData(form));const res=await fetch('/api/users/'+action,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify(action==='logout'?{}:body)});const data=await res.json();if(!res.ok)throw Error(Array.isArray(data.message)?data.message.join('\n'):data.message);message.textContent=action==='register'?'Регистрация выполнена. Теперь войдите.':action==='logout'?'Вы вышли из системы.':'Вход выполнен';if(action==='auth')location.href='/insulin/tile';}catch(e){message.textContent=e.message;}}
form.addEventListener('submit',e=>{e.preventDefault();send('auth')});document.querySelector('#register').onclick=()=>{if(form.reportValidity())send('register')};document.querySelector('#logout').onclick=()=>send('logout');
</script></body></html>